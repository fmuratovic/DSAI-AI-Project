<?xml version="1.0"?>
<DevRes>

    <Images>
        <!-- Application / UI icons.
             appIcon points at an in-repo asset rather than a path under the
             user's local framework install, so a fresh clone builds without
             the icon having to be copied into Work/Common/Icons by hand. -->
        <Res id="appIcon" path=":../assets/wn.png"/>

        <Res id="reset"    path="Work/Common/Icons/arrow_cycle.png"/>
        <Res id="redo"    path="Work/Common/Icons/arrow_right.png"/>
	<Res id="undo" path="Work/Common/Icons/arrow_left.png"/>
        <Res id="stop"     path="Work/Common/Icons/x.png"/>
        <Res id="settings" path="Work/Common/Icons/SettingsBlue48.png"/>

        <!-- Chess board -->
        <Res id="board" path="Work/Common/Images/Chess/ChessBoard1024.jpg"/>

        <!-- Menu background -->
        <Res id="chessBg" path=":../assets/chess_bg.jpg"/>

        <!-- Chess pieces.
             These were previously loaded in code as bare relative paths
             ("../assets/bk.png"), which resolve against the process's
             CURRENT WORKING DIRECTORY at runtime rather than the
             executable's location. That only works when the app is launched
             from the build output folder: a macOS .app started from Finder
             has a working directory of "/", so the pieces silently failed
             to load. Registering them here lets the code reference them by
             resource id (":blackKing"), which the framework resolves
             relative to the bundled resources on every platform. -->
        <Res id="blackKing"   path=":../assets/bk.png"/>
        <Res id="blackQueen"  path=":../assets/bq.png"/>
        <Res id="blackRook"   path=":../assets/br.png"/>
        <Res id="blackBishop" path=":../assets/bb.png"/>
        <Res id="blackKnight" path=":../assets/bn.png"/>
        <Res id="blackPawn"   path=":../assets/bp.png"/>

        <Res id="whiteKing"   path=":../assets/wk.png"/>
        <Res id="whiteQueen"  path=":../assets/wq.png"/>
        <Res id="whiteRook"   path=":../assets/wr.png"/>
        <Res id="whiteBishop" path=":../assets/wb.png"/>
        <Res id="whiteKnight" path=":../assets/wn.png"/>
        <Res id="whitePawn"   path=":../assets/wp.png"/>
    </Images>

    <Sounds>
        <Res id="move"    path="Work/Common/Sounds/ChessCapture.wav"/>
        <Res id="success" path="Work/Common/Sounds/MissionSuccess.wav"/>
    </Sounds>

</DevRes>